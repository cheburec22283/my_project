<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Базовая тема окна. Внутри приложения всё рисует Compose (FoodDeliveryTheme),
         эта тема отвечает за системные бары и фон до первого кадра. -->
    <style name="Theme.FoodDelivery" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/forest</item>
        <item name="android:colorPrimaryDark">@color/forest_deep</item>
        <item name="android:colorAccent">@color/forest</item>
        <item name="android:colorBackground">@color/mint</item>
        <item name="android:windowBackground">@color/mint</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_soft</item>

        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>

        <item name="android:windowAnimationStyle">@style/Animation.FoodDelivery.Window</item>
    </style>

</resources>
